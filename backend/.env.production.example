# Copy to .env on the production host — never commit real secrets.
APP_NAME=JV-OMS
APP_ENV=production
API_V1_PREFIX=/api/v1
DEBUG=false

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_MINIMUM_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Aiven MySQL (URL-encode special chars in password)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
MYSQL_SSL_REQUIRED=true
MYSQL_SSL_CA=/absolute/path/to/aiven-ca.pem

# Persistent evidence (outside deploy folder preferred)
EVIDENCE_ROOT=/var/jvoms/evidence

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1

# WhatsApp — Meta optional; mock OTP is accepted when WHATSAPP_ALLOW_MOCK=true
WHATSAPP_ALLOW_MOCK=true
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MANAGEMENT_ALERT_MOBILES=

AI_PROVIDER=on_device_mlkit
AI_API_KEY=

# JV yard (Chittoor approx) — refine exact plant pin in Settings
GPS_GEOFENCE_LAT=13.2172
GPS_GEOFENCE_LON=79.1004
GPS_GEOFENCE_RADIUS_M=500
GPS_MAX_ACCURACY_M=50
GPS_ENFORCE=true

# Explicit origins only (PWA HTTPS + Capacitor if needed)
CORS_ORIGINS=https://oms.your-domain.example
