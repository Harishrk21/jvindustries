# Application
APP_NAME=JV-OMS
# development | production — production refuses weak JWT, DEBUG=true, CORS=*
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# Security — replace in production (≥32 random chars; never commit real secret)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# MySQL ONLY (Aiven example)
# Password special chars must be URL-encoded (@ → %40)
# DATABASE_URL=mysql+pymysql://avnadmin:PASSWORD@YOUR_HOST:PORT/defaultdb?charset=utf8mb4
DATABASE_URL=mysql+pymysql://jvoms:JvOms%402026@127.0.0.1:3306/jvoms?charset=utf8mb4
MYSQL_SSL_REQUIRED=true
MYSQL_SSL_CA=certs/aiven-ca.pem

# Object storage (S3-compatible) — optional until configured
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
EVIDENCE_ROOT=./evidence_store

# WhatsApp Business API (optional until go-live)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MANAGEMENT_ALERT_MOBILES=

# AI — set GROQ_API_KEY for cloud vision ANPR (preferred over on-device OCR alone)
AI_PROVIDER=groq_vision
AI_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Geofence (configure to real JV premises before production)
GPS_GEOFENCE_LAT=13.0827
GPS_GEOFENCE_LON=80.2707
GPS_GEOFENCE_RADIUS_M=300
GPS_MAX_ACCURACY_M=250
# false = allow yard testing off-site / desktop GPS; must be true in production
GPS_ENFORCE=false

# CORS — explicit origins in production (no *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- production sketch ---
# APP_ENV=production
# DEBUG=false
# JWT_SECRET=<openssl rand -hex 32>
# CORS_ORIGINS=https://oms.jvindustries.example
# DATABASE_URL=mysql+pymysql://...@aiven-host:port/defaultdb?charset=utf8mb4
# MYSQL_SSL_REQUIRED=true
# MYSQL_SSL_CA=certs/aiven-ca.pem
